            result.body || "";

        if (Array.isArray(result.todos)) {

            currentTodos =
                result.todos;

            displayTodos(
                currentTodos
            );

        }

    } catch (error) {

        setStatus("REPORT: ERROR");

        responseElement.textContent =
            `${error.name}: ${error.message}`;

        console.error(
            "REPORT ERROR:",
            error
        );
    }
}


