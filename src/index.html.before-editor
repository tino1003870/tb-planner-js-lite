<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>TB Planner</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

<header class="planner-header">

    <div class="title-row">
        <h1>TB Planner</h1>
    </div>

    <div class="connection-row">

        <label for="serverUrl">Kalender:</label>

        <input
            id="serverUrl"
            type="text"
            value="https://caldav.web.de/begenda/dav/bofhdd@web.de/calendar"
        >

        <button id="refreshButton" type="button">
            ↻
        </button>

    </div>

    <div class="credentials-row">

        <label for="username">Benutzer:</label>

        <input
            id="username"
            type="text"
            value="bofhdd@web.de"
        >

        <label for="password">Passwort:</label>

        <input
            id="password"
            type="password"
        >

    </div>

    <div class="task-toolbar">

        <button id="newTaskButton" type="button">
            Task erstellen
        </button>

        <button id="renameTaskButton" type="button" disabled>
            Titel ändern
        </button>

        <button id="deleteTaskButton" type="button" disabled>
            Task löschen
        </button>

    </div>

    <div class="planner-toolbar">

        <div class="toolbar-group">

            <button id="indentButton" type="button" disabled>
                → Einrücken
            </button>

            <button id="outdentButton" type="button" disabled>
                ← Ausrücken
            </button>

            <button id="moveUpButton" type="button" disabled>
                ↑
            </button>

            <button id="moveDownButton" type="button" disabled>
                ↓
            </button>

        </div>

        <div class="toolbar-group">

            <button id="previousWeekButton" type="button">
                − Woche
            </button>

            <button id="previousDayButton" type="button">
                − Tag
            </button>

            <button id="nextDayButton" type="button">
                + Tag
            </button>

            <button id="nextWeekButton" type="button">
                + Woche
            </button>

        </div>

        <div class="toolbar-group">

            <button id="durationMinusButton" type="button">
                − Dauer
            </button>

            <button id="durationPlusButton" type="button">
                + Dauer
            </button>

        </div>

        <div class="toolbar-group zoom-group">

            <span>Zoom:</span>

            <button id="zoomDayButton" type="button">
                Tag
            </button>

            <button id="zoomWeekButton" type="button">
                Woche
            </button>

            <button id="zoomMonthButton" type="button">
                Monat
            </button>

            <button id="zoomYearButton" type="button">
                KW
            </button>

        </div>

    </div>

</header>


<main class="planner-main">

    <section class="planner">

        <div class="planner-table-header">

            <div class="wbs-header">
                WBS
            </div>

            <div class="task-header">
                Aufgabe
            </div>

            <div
                id="timelineHeader"
                class="timeline-header"
            >
                <!-- timeline generated by JavaScript -->
            </div>

        </div>


        <div
            id="plannerRows"
            class="planner-rows"
        >
            <!-- planner rows generated by JavaScript -->
        </div>

    </section>

</main>


<footer class="planner-footer">

    <span id="status">
        Bereit
    </span>

</footer>


<!--
    Debug output is deliberately kept in the DOM.
    It can be hidden later without removing the functionality.
-->

<section class="debug-panel">

    <details>

        <summary>CalDAV Debug</summary>

        <pre id="headers"></pre>

        <pre id="response"></pre>

    </details>

</section>


<script type="module" src="js/app.js"></script>

</body>
</html>
